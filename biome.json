{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "app.js",
      "live-auth.js",
      "runtime-config.js",
      "api/**/*.js",
      "data/mock-data.js",
      "tests/**/*.js"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
